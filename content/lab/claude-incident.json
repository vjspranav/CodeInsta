    {
      "duration_ms": 12000,
      "caption": "The real fix",
      "lines": [
        {
          "speaker": "sre",
          "text": "Fix one: request coalescing. One request rebuilds a key. The rest wait."
        },
        {
          "speaker": "oc",
          "text": "Two: jittered TTLs, so keys never expire together."
        },
        {
          "speaker": "sre",
          "text": "Three: warm the cache before it takes traffic."
        }
