 "glossary": [
  {
   "term": "Paxos",
   "full": "A family of consensus protocols from Leslie Lamport",
   "note": "Single-decree Paxos chooses one value."
  },
  {
   "term": "proposer",
   "full": "The role that asks acceptors to accept a value",
   "note": "The couriers in this analogy."
  },
  {
   "term": "acceptor",
   "full": "The role that promises and accepts proposals",
   "note": "The clerks; real ones persist state before replying."
  },
  {
   "term": "quorum",
   "full": "A majority of the acceptors",
   "note": "Any two quorums share at least one acceptor."
  }
 ],
 "key_points": [
  "Prepare blocks stale proposals and reveals earlier accepts.",
  "A proposer must reuse the highest-numbered accepted value it hears about.",
  "Any two majorities overlap, so only one value is ever chosen."
 ],
