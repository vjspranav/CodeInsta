 "glossary": [
  {
   "term": "CFG",
   "full": "Control Flow Graph",
   "note": "Basic blocks joined by the jumps between them."
  },
  {
   "term": "dominance frontier",
   "full": "First blocks a block no longer dominates",
   "note": "Where phi nodes belong."
  },
  {
   "term": "phi node",
   "full": "A merge that picks a value by the incoming edge",
   "note": "Sits at the start of a join block."
  }
 ],
 "key_points": [
  "X dominates Y when every path from the entry to Y goes through X.",
  "The immediate dominators form a tree that many passes query.",
  "The dominance frontier is where phi nodes are placed."
 ],
