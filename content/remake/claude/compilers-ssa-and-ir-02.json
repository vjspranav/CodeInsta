    {
     "do": "term.run",
     "cmd": "clang --analyze -Xclang -analyzer-checker=debug.DumpDominators d.c",
     "out": [
      "Immediate dominance tree (Node#,IDom#):",
      "(0,1)",
      "(1,4)",
      "(2,4)",
      "(3,4)",
      "(4,5)",
      "(5,5)"
