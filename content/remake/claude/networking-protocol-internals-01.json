 "glossary": [
  {
   "term": "Reno",
   "full": "A classic loss-based TCP algorithm",
   "note": "Adds one segment per round trip, halves on loss."
  },
  {
   "term": "BBR",
   "full": "Bottleneck Bandwidth and Round-trip propagation time",
   "note": "Paces to a measured bandwidth."
  },
  {
   "term": "BDP",
   "full": "Bandwidth-Delay Product",
   "note": "Bandwidth times round-trip time: the volume of the pipe."
  },
  {
   "term": "RTT",
   "full": "Round-Trip Time"
  }
 ],
 "key_points": [
  "Reno and CUBIC react to loss with different growth curves.",
  "BBR estimates bandwidth and minimum round-trip time and paces to that model.",
  "Loss-based senders keep queues full; BBR aims for a small queue."
 ],
 "sources": [
  "https://www.rfc-editor.org/rfc/rfc9438",
  "https://queue.acm.org/detail.cfm?id=3022184"
 ],
