 "glossary": [
  {
   "term": "Raft",
   "full": "A consensus algorithm designed to be understandable",
   "note": "Replicates a log across servers."
  },
  {
   "term": "term",
   "full": "A numbered period with at most one leader",
   "note": "Acts as a logical clock."
  },
  {
   "term": "no-op",
   "full": "No operation",
   "note": "An empty entry a new leader appends to commit older ones."
  }
 ],
 "key_points": [
  "Majority replication alone does not make an old-term entry safe (Figure 8).",
  "A leader commits only entries from its own term by counting replicas.",
  "Committing one current-term entry commits everything before it."
 ],
 "sources": [
  "https://raft.github.io/raft.pdf"
 ],
