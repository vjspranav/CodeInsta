              "paid",
              "visible"
            ]
          ],
          "at": "start"
        }
      ]
    },
    {
      "speaker": "rookie",
      "text": "The rows vanished, but the file did not shrink. Did PostgreSQL keep my rubbish?",
      "visuals": [
        {
          "do": "sketch.note",
          "text": "MYTH: DELETE shrinks the file",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "senior",
      "text": "Not necessarily. Multi-Version Concurrency Control keeps old row versions until no transaction needs them.",
      "visuals": [
        {
          "do": "define",
          "term": "MVCC",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "rookie",
      "text": "Then what changes when ordinary VACUUM processes those dead versions?",
      "visuals": [
        {
          "do": "sketch.note",
          "text": "Mira traces old row version",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "senior",
      "text": "It makes dead space reusable inside the relation. Usually that space is not returned to the operating system.",
      "visuals": [
        {
          "do": "layout",
          "template": "board-full"
        },
        {
          "do": "timeline.track",
          "id": "space",
          "lanes": [
            "Dead versions",
            "Table space",
            "Operating system"
          ],
          "span": [
            0,
            100
          ],
          "blocks": [
            {
              "lane": "Dead versions",
              "start": 0,
              "end": 40,
              "label": "cleanup"
            },
            {
              "lane": "Table space",
              "start": 40,
              "end": 100,
              "label": "available for reuse"
            }
          ],
          "at": "start"
        },
        {
          "do": "sketch.note",
          "text": "FACT: reusable space inside relation",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "rookie",
      "text": "Can I treat the dead-tuple estimate as an exact measurement of table bloat?",
      "visuals": [
        {
          "do": "sketch.note",
          "text": "Mira: exact bloat number?",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "senior",
      "text": "No. Treat estimates and autovacuum timestamps as clues; compare trends, transaction age, and workload.",
      "visuals": [
        {
          "do": "layout",
          "template": "db-focus"
        },
        {
          "do": "db.table",
          "id": "signals",
          "name": "maintenance clues",
          "columns": [
            "signal",
            "meaning"
          ],
          "rows": [
            [
              "estimated dead tuples",
              "rough clue"
            ],
            [
              "last autovacuum",
              "recent activity"
            ],
            [
              "old transaction",
              "possible cleanup horizon"
            ]
          ],
          "at": "start"
        }
      ]
    },
    {
      "speaker": "rookie",
      "text": "If cleanup is behind, should I immediately lower this table’s autovacuum scale factor?",
      "visuals": [
        {
          "do": "sketch.note",
          "text": "Mira: tune threshold now?",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "senior",
      "text": "Check blockers and vacuum capacity first. Threshold tuning cannot explain why cleanup falls behind.",
      "visuals": [
        {
          "do": "layout",
          "template": "board-full"
        },
        {
          "do": "sketch.note",
          "text": "check blockers → capacity → thresholds",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "rookie",
      "text": "What if I need the file itself to shrink and return disk space?",
      "visuals": [
        {
          "do": "sketch.note",
          "text": "Mira: reclaim disk space?",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "senior",
      "text": "VACUUM FULL rewrites the table. It can return space, but needs extra disk and an ACCESS EXCLUSIVE lock.",
      "visuals": [
        {
          "do": "layout",
          "template": "board-full"
        },
