  "glossary": [
    {
      "term": "MVCC",
      "full": "Multi-Version Concurrency Control",
      "note": "PostgreSQL keeps row versions so concurrent transactions can see a consistent view."
    },
    {
      "term": "VACUUM FULL",
      "full": "PostgreSQL table-rewriting vacuum operation",
      "note": "Can return space to the operating system, but rewrites the table and takes an exclusive lock."
    }
  ],
  "beats": [
    {
      "speaker": "narrator",
      "text": "Cleanup day. Mira deletes old orders, then stares at the stubbornly large table file.",
      "visuals": [
        {
          "do": "layout",
          "template": "db-focus"
        },
        {
          "do": "db.table",
          "id": "orders",
          "name": "orders (illustrative rows)",
          "columns": [
            "order_id",
