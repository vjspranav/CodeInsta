          "do": "code.editor",
          "id": "vacuum",
          "title": "Two different operations",
          "lines": [
            "VACUUM orders;",
            "VACUUM FULL orders;"
          ],
          "at": "start"
        },
        {
          "do": "define",
          "term": "VACUUM FULL",
          "at": "start"
        }
      ]
    },
    {
      "speaker": "rookie",
      "text": "I will inspect old transactions first. The maintenance window can wait; perhaps the next inserts can reuse this space.",
      "visuals": [
        {
          "do": "sketch.note",
          "text": "Mira records safe next step",
          "at": "start"
        }
