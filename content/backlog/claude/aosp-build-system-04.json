          "text": "foo.h (touched)",
          "x": 8,
          "y": 22,
          "w": 40,
          "h": 10,
          "color": "red",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "o",
          "type": "box",
          "text": "foo.o (older)",
          "x": 52,
          "y": 22,
          "w": 40,
          "h": 10,
