          "label": "newer than"
        },
        {
          "id": "n",
          "type": "text",
          "text": "mtime(input) > mtime(output) => dirty",
          "x": 8,
          "y": 46,
          "w": 84,
          "h": 10,
          "color": "gray",
          "at": 4000,
          "enter": "fade"
        }
      ]
