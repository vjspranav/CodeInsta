      "caption": "Ninja compares file mtimes along the dependency graph; touching foo.h makes it newer than its objects.",
      "narration": "Ninja compares modification times along the graph. Touch foo.h and it becomes newer than every object that included it.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Touch one header",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "h",
