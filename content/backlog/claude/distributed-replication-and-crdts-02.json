    },
    {
      "duration_ms": 9000,
      "caption": "Tombstones grow forever unless pruned using causal knowledge.",
      "narration": "The catch: tombstones accumulate. Optimized OR-Sets drop them using version vectors, once every replica has seen the remove.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "The cost",
          "x": 8,
          "y": 6,
