    {
      "duration_ms": 11000,
      "caption": "Sequential keys fill the rightmost leaf; random keys split everywhere.",
      "narration": "With increasing keys, inserts hit the rightmost leaf and leave full pages behind. With random UUIDs, inserts land on random leaves and split pages about half full.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Why UUIDs hurt",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Sequential: rightmost leaf, dense pages",
            "Random UUIDv4: random leaves, ~half-full pages",
            "Whole index stays hot in cache",
            "More page writes into WAL"
          ],
          "x": 8,
          "y": 20,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
