    },
    {
      "duration_ms": 10000,
      "caption": "Prefer time-ordered keys, and check leaf density with pgstatindex.",
      "narration": "Time-ordered keys such as UUIDv7 or a bigserial restore locality. You can check leaf density with the pgstattuple extension.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Fixes",
          "x": 8,
          "y": 6,
          "w": 84,
