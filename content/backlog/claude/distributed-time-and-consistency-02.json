      "duration_ms": 10000,
      "caption": "One counter per node: V[i] counts events seen from node i.",
      "narration": "A vector clock keeps one counter per node. Node i bumps its own slot on local events and sends, and merges slot by slot on receive.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Vector clock rules",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "r",
          "type": "list",
          "items": [
            "Node i holds V[0..N-1]",
            "Local event or send: V[i]++",
            "Receive m: V = max(V, m.V), then V[i]++"
          ],
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "f",
          "type": "highlight",
          "target": "r",
          "at": 4500,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "A happened-before B if every slot of A is <= B (and one is <).",
      "narration": "Compare two vectors slot by slot. If A is less than or equal to B everywhere, A causally precedes B.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Ordered: A before B",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "A = [2, 1, 0]\nB = [2, 3, 0]",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "t",
          "type": "text",
          "text": "A <= B in every slot, and 1 < 3",
          "x": 8,
          "y": 40,
          "w": 84,
          "at": 2500,
          "enter": "fade"
        },
        {
          "id": "res",
          "type": "box",
          "text": "A happened before B",
          "x": 8,
          "y": 56,
          "w": 84,
          "h": 10,
