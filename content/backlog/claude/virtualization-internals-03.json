    {
      "duration_ms": 13500,
      "caption": "A split virtqueue is three structures in guest RAM: descriptors, avail ring, used ring.",
      "narration": "A virtqueue lives entirely in guest memory that the host can also read. It has a descriptor table, an available ring written by the driver, and a used ring written by the device.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Three shared structures",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "desc",
          "type": "box",
          "text": "Descriptor table",
          "x": 8,
          "y": 20.0,
          "w": 84,
          "h": 11,
          "color": "blue",
          "at": 600,
          "enter": "pop"
        },
        {
          "id": "avail",
          "type": "box",
          "text": "Avail ring (driver writes)",
          "x": 8,
          "y": 40.0,
          "w": 36,
