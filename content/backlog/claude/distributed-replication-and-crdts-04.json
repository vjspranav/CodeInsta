    {
      "duration_ms": 11000,
      "caption": "If R + W > N, every read set overlaps every write set.",
      "narration": "If R plus W exceeds N, any read quorum must share at least one replica with the latest write quorum, so the read can see the newest version.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Overlap rule",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "R + W > N\n2 + 2 > 3   ->  overlap",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
