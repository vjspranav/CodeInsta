    {
      "duration_ms": 11000,
      "caption": "Tune the trade-off: W=1 favors write availability; R=1, W=N favors reads.",
      "narration": "Lower W makes writes fast and always available but weaker. R equal to one with W equal to N gives cheap reads. Lower quorums raise staleness risk.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Tuning",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "W = 1: fastest writes, stale reads",
            "R = 1, W = N: cheap reads, writes block if any node is down",
            "R + W <= N: eventual consistency only"
          ],
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "f",
          "type": "highlight",
          "target": "l",
          "at": 6500,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "Sloppy quorums and hinted handoff keep writes available but weaken the overlap.",
      "narration": "During failures Dynamo writes to the next healthy nodes and hands the data back later. That keeps writes available, but the overlap guarantee is lost.",
      "elements": [
        {
