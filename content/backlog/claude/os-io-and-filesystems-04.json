        },
        {
          "id": "c",
          "type": "code",
          "lang": "c",
          "text": "struct io_uring_sqe {\n  __u8  opcode;\n  __s32 fd;\n  __u64 off, addr;\n  __u32 len;\n  __u64 user_data;\n};",
          "x": 8,
