        },
        {
          "id": "c",
          "type": "code",
          "lang": "c",
          "text": "rcu_read_lock();\np = rcu_dereference(gp);\nif (p) use(p->val);\nrcu_read_unlock();",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 20.6,
          "at": 500,
          "enter": "fade"
        },
        {
          "id": "n",
