    {
      "duration_ms": 9500,
      "caption": "Lookup walks from the innermost scope outward, and the first hit wins.",
      "narration": "Lookup starts at the innermost scope and walks outward. The first match wins, which is shadowing. Falling off the end means undeclared.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Lookup",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "fn lookup(name):\n  for scope in stack.reversed():\n    if name in scope:\n      return scope[name]\n  error(\"undeclared\")",
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "at": 1300
        },
        {
          "id": "hl",
          "type": "highlight",
          "target": "c",
          "at": 2100
        }
      ]
