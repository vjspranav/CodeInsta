    {
      "duration_ms": 10000,
      "caption": "PN-Counter: two G-Counters, P for increments and N for decrements.",
      "narration": "A G-Counter cannot decrement, since max would never go down. A PN-Counter pairs two G-Counters: one counts increments, one counts decrements.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "PN-Counter",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "p",
          "type": "box",
          "text": "P: increments",
          "x": 8,
          "y": 22,
          "w": 38,
          "h": 10,
          "color": "green",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "n",
          "type": "box",
          "text": "N: decrements",
          "x": 54,
          "y": 22,
          "w": 38,
          "h": 10,
          "color": "red",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "value() = sum(P) - sum(N)\nmerge: max each of P and N",
          "x": 8,
          "y": 44,
