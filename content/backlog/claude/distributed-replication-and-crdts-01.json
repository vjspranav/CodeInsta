    {
      "duration_ms": 10000,
      "caption": "Merge is slot-wise max: commutative, associative, idempotent.",
      "narration": "To merge, take the maximum slot by slot. Max is commutative, associative, and idempotent, so order and duplicates do not matter.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Merge = max",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "merge(P, Q)[i] =\n  max(P[i], Q[i])",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Commutative: merge(P,Q) = merge(Q,P)",
            "Associative: any grouping",
            "Idempotent: merge(P,P) = P"
