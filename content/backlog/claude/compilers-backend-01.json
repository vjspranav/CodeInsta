    {
      "duration_ms": 10000,
      "caption": "A node that gets no color is spilled: store after each def, load before each use, then rebuild.",
      "narration": "If select finds no color, the value is spilled: a store after each definition, a load before each use. Then the graph is rebuilt.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Spilling",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "v5 = ...\nstore v5 -> [sp+8]\n...\nv5' = load [sp+8]\nuse v5'",
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
