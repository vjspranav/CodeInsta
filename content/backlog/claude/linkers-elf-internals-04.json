    {
      "duration_ms": 11500,
      "caption": "A strong definition beats weak ones; among weaks any one wins.",
      "narration": "If one definition is strong and others are weak, the strong one is chosen silently. Several weak definitions are fine too, and the linker takes one of them.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Rule 2 and 3: weak loses",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "w",
          "type": "code",
          "lang": "c",
          "text": "__attribute__((weak)) int f(void);\n/* libA: weak f */\n/* app:  strong f -> chosen */",
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up"
        },
        {
          "id": "n",
          "type": "text",
          "text": "Undefined weak symbols resolve to 0.",
          "x": 8,
