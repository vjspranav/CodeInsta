    {
      "duration_ms": 9000,
      "caption": "Stable AIDL reuses the same language and binder driver that apps and the framework already use.",
      "narration": "Stable AIDL reuses the language, compiler and /dev/binder that Android already uses. Marking an interface vintf stable makes it a HAL.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Stable AIDL",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "java",
          "text": "@VintfStability\ninterface IFoo {\n    int bar();\n}",
          "x": 8,
          "y": 20,
          "w": 84,
          "h": 18,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "t",
          "type": "box",
          "text": "/dev/binder + servicemanager",
          "x": 15,
          "y": 46,
          "w": 70,
          "h": 10,
          "color": "green",
          "at": 3500,
          "enter": "pop"
        },
