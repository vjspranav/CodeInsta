    {
      "duration_ms": 10000,
      "caption": "Enable with kvm-arm.mode=protected; Android's AVF runs protected VMs via crosvm.",
      "narration": "Protected mode is selected at boot with kvm-arm dot mode equals protected. The Android Virtualization Framework uses it to run protected VMs, launched by crosvm.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "In Android",
