    {
      "duration_ms": 9000,
      "caption": "epoll splits registering from waiting: add each fd once, then wait many times.",
      "narration": "epoll splits registration from waiting. You create an instance, add each descriptor once, and then call wait repeatedly without resending anything.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Register once, wait often",
          "x": 8,
          "y": 6,
