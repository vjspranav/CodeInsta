    {
      "duration_ms": 10000,
      "caption": "Admission control: sched_setattr fails with EBUSY if total runtime/period would exceed capacity.",
      "narration": "Admission control checks that the sum of runtime over period fits the available capacity. A task that would overload it is rejected with EBUSY.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Admission control",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "a",
          "type": "list",
          "items": [
            "Need runtime <= deadline <= period",
            "Sum of runtime/period <= RT limit x CPUs",
            "Over budget: sched_setattr -> EBUSY"
          ],
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 32.9,
