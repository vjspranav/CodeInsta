    {
      "duration_ms": 10000,
      "caption": "SCHED_FIFO: fixed priority 1-99; runs until it blocks, yields or a higher priority arrives.",
      "narration": "SCHED_FIFO has static priorities from one to ninety-nine. A task runs until it blocks, yields, or a higher-priority task becomes runnable. No timeslice.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "SCHED_FIFO",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "bash",
          "text": "chrt -f 50 ./task",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 7.4,
          "at": 500,
          "enter": "fade"
        },
        {
          "id": "f",
          "type": "list",
          "items": [
            "Priorities 1-99, higher wins",
            "No timeslice: runs until it blocks",
            "Same priority: FIFO queue order"
          ],
          "x": 8,
          "y": 38,
          "w": 84,
          "h": 28.5,
          "at": 3500,
          "enter": "slide-up"
        }
      ]
    },
    {
      "duration_ms": 9000,
      "caption": "SCHED_RR adds a timeslice to FIFO so equal priorities rotate; RT throttling caps total RT time.",
      "narration": "SCHED_RR adds a time slice so equal-priority tasks rotate, by default one hundred milliseconds. RT throttling normally caps real-time runtime at ninety-five percent.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "SCHED_RR and RT throttling",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "r",
          "type": "list",
          "items": [
            "RR: FIFO plus a slice, default 100 ms",
            "sched_rt_runtime_us = 950000",
            "sched_rt_period_us = 1000000"
          ],
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 24.1,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "hl",
          "type": "highlight",
          "target": "r",
          "at": 6000,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "SCHED_DEADLINE gives each task (runtime, deadline, period); EDF picks the earliest absolute deadline.",
      "narration": "SCHED_DEADLINE declares runtime, deadline and period per task. The kernel runs earliest-deadline-first and a constant bandwidth server stops overruns.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "SCHED_DEADLINE",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "s",
          "type": "code",
          "lang": "c",
          "text": "struct sched_attr {\n  u64 sched_runtime;\n  u64 sched_deadline;\n  u64 sched_period;\n};",
