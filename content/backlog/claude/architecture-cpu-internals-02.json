    {
      "duration_ms": 11500,
      "caption": "The longest table whose tag matches provides the prediction.",
      "narration": "On lookup, every table is checked in parallel. The matching entry with the longest history wins and provides the prediction, so rare, long patterns override the simple default.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Longest match wins",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
