    {
      "duration_ms": 11000,
      "caption": "Simple predictors use a table of 2-bit saturating counters indexed by PC.",
      "narration": "The baseline is a table of two-bit counters indexed by the branch address. It handles biased branches but can't see correlations between nearby branches.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "The bimodal baseline",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "s",
          "type": "list",
          "items": [
            "00, 01: predict not taken",
            "10, 11: predict taken",
            "Taken: +1, saturate at 11",
            "Not taken: -1, saturate at 00"
          ],
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up",
          "color": "purple"
        }
      ]
    },
    {
      "duration_ms": 12000,
      "caption": "TAGE adds several tagged tables indexed by PC hashed with global history of geometric lengths.",
      "narration": "TAGE keeps a base predictor plus several tagged tables. Each is indexed by the PC hashed with a different length of global branch history, with lengths forming a geometric series.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Tagged geometric history",
          "x": 8,
          "y": 6,
          "w": 84,
