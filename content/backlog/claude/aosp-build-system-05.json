          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "make",
          "text": "BOARD_SUPER_PARTITION_SIZE := <bytes>\nBOARD_SUPER_PARTITION_GROUPS := grp\nBOARD_GRP_SIZE := <bytes>\nBOARD_GRP_PARTITION_LIST := \\\n    system vendor product",
