    {
      "duration_ms": 9000,
      "caption": "Slow and crashed look the same, so no algorithm can tell them apart in an asynchronous model.",
      "narration": "A slow process is indistinguishable from a crashed one. Practical systems relax the model with randomization, partial synchrony, or failure detectors.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Ways out",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Randomization (Ben-Or)",
            "Partial synchrony (Dwork-Lynch-Stockmeyer)",
            "Failure detectors (Chandra-Toueg)",
            "Raft: randomized election timeouts"
          ],
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "color": "purple",
          "at": 1300
        }
      ]
    },
    {
      "duration_ms": 11500,
      "caption": "Paxos and Raft never violate safety; they only lose liveness when the network misbehaves.",
      "narration": "So Paxos and Raft stay safe under any delays and progress only when the system is stable enough. FLP does not say consensus is impossible in practice.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "In practice",
          "x": 8,
          "y": 5,
