    {
      "duration_ms": 8000,
      "caption": "FLP assumes asynchronous timing, reliable messages, deterministic processes and at most one crash.",
      "narration": "FLP assumes no bounds on message delay or process speed, reliable messages, deterministic processes, and at most one crash.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "The model",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Asynchronous: no timing bounds",
            "Reliable message delivery",
            "Deterministic processes",
            "At most 1 crash failure",
            "Agreement + validity + termination"
          ],
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "color": "blue",
          "at": 1300
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "No deterministic protocol can guarantee termination here; safety alone is still achievable.",
      "narration": "No deterministic protocol can guarantee agreement, validity and termination together. Safety can be kept, but termination cannot be guaranteed, even with one crash.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "The theorem",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "s",
          "type": "box",
          "text": "Safety: achievable",
          "x": 8,
          "y": 20,
          "w": 40,
          "h": 10,
          "color": "green",
          "enter": "pop",
          "at": 1300
        },
        {
          "id": "l",
          "type": "box",
          "text": "Termination: no guarantee",
          "x": 52,
          "y": 20,
          "w": 40,
          "h": 10,
          "color": "red",
          "enter": "pop",
          "at": 2100
        },
        {
          "id": "n",
          "type": "text",
          "text": "It is about guarantees, not typical executions.",
          "x": 8,
          "y": 44,
          "w": 84,
          "enter": "fade",
          "color": "gray",
          "at": 2900
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "The proof keeps the system bivalent by delaying one critical message forever.",
      "narration": "A bivalent start state exists, where either decision is still possible. An adversarial scheduler can keep delaying one message and stay bivalent forever.",
