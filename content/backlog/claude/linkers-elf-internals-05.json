    {
      "duration_ms": 11500,
      "caption": "A PT_TLS template (.tdata + .tbss) is copied per thread; the thread pointer finds it.",
      "narration": "Thread-locals live in a PT_TLS template with initialized .tdata and zeroed .tbss. Each thread gets a copy, and on x86-64 the fs register points at the thread's block.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Per-thread copies",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "tpl",
          "type": "box",
          "text": "PT_TLS template",
          "x": 8,
          "y": 20.0,
          "w": 36,
          "h": 14.2,
          "color": "blue",
          "at": 600,
          "enter": "pop"
        },
        {
          "id": "th",
          "type": "box",
          "text": "Thread block",
          "x": 56,
          "y": 20.0,
          "w": 36,
          "h": 14.2,
          "color": "green",
          "at": 600,
          "enter": "pop"
        },
        {
          "id": "fs",
          "type": "text",
          "text": "%fs base = thread pointer (TCB)",
          "x": 8,
          "y": 43.2,
          "w": 84,
