      "duration_ms": 9000,
      "caption": "If vendor code links a private system library, a system update can silently break it.",
      "narration": "If a vendor library links a private system library, any system update that changes it can break the vendor image, which Treble must prevent.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "The problem",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "v",
          "type": "box",
          "text": "vendor libfoo.so",
          "x": 8,
          "y": 22,
          "w": 40,
          "h": 10,
          "color": "orange",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "s",
          "type": "box",
          "text": "system libprivate.so",
          "x": 52,
          "y": 22,
          "w": 40,
          "h": 10,
          "color": "red",
          "at": 1200,
          "enter": "pop"
        },
        {
