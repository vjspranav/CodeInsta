    {
      "duration_ms": 10000,
      "caption": "Register machines need fewer instructions than stack machines: no push and pop copies.",
      "narration": "JVM bytecode shuffles operands through a stack. Dex instructions name registers directly, so one add-int replaces four stack instructions.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Registers vs stack",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "j",
          "type": "code",
          "lang": "text",
          "text": "; JVM\niload_1\niload_2\niadd\nistore_3",
          "x": 8,
          "y": 20,
          "w": 40,
          "h": 20,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "d",
          "type": "code",
          "lang": "text",
          "text": "# dex\nadd-int v3, v1, v2",
          "x": 52,
          "y": 20,
          "w": 40,
          "h": 10,
          "at": 2500,
          "enter": "slide-up"
        },
        {
          "id": "n",
          "type": "text",
          "text": "Fewer dispatches in the interpreter",
          "x": 8,
          "y": 48,
