    {
      "duration_ms": 10000,
      "caption": "Three mechanisms enforce the boundary: SELinux, linker namespaces and VINTF.",
      "narration": "The boundary is enforced three ways. SELinux policy is split per partition, linker namespaces block private library links, and VINTF manifests declare what each side provides.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Enforcing the contract",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "SELinux: split sepolicy",
            "Linker namespaces + VNDK",
            "VINTF manifests + matrices"
          ],
          "x": 8,
          "y": 20,
          "w": 84,
          "h": 24,
          "color": "purple",
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "n",
          "type": "text",
          "text": "Each rule is checked at build time or runtime",
          "x": 8,
          "y": 52,
          "w": 84,
          "h": 10,
          "color": "gray",
          "at": 5000,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "A GSI is a system.img built from AOSP, flashed over the device's own vendor.img.",
      "narration": "A generic system image is a pure system.img from AOSP. Because the vendor interface is stable, it can run on top of the device's untouched vendor image.",
      "elements": [
