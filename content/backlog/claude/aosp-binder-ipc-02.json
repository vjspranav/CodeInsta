          "x": 8,
          "y": 22,
          "w": 84,
          "h": 10,
          "color": "blue",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "o",
          "type": "box",
          "text": "offsets[]: where objects sit",
          "x": 8,
          "y": 42,
          "w": 84,
          "h": 10,
          "color": "orange",
          "at": 2000,
          "enter": "pop"
        },
        {
          "id": "a",
          "type": "arrow",
          "from": "o",
          "to": "d",
          "at": 3500,
