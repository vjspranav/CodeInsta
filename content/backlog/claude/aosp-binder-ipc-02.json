    {
      "duration_ms": 9000,
      "caption": "A Parcel has a data buffer plus an array of offsets that mark embedded objects.",
      "narration": "A Parcel is a flat buffer plus an offsets array. Primitives and strings go in the buffer; offsets point at special objects inside it.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Parcel layout",
          "x": 8,
