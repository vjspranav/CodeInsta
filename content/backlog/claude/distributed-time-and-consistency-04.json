    {
      "duration_ms": 9000,
      "caption": "A write picks its commit timestamp s >= TT.now().latest.",
      "narration": "When a transaction is ready to commit, the leader picks a commit timestamp s no smaller than TT.now latest.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Pick the timestamp",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "s = TT.now().latest\n// s >= every earlier commit\n// the leader could have seen",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "n",
          "type": "text",
          "text": "But s may still be in the future of some clocks.",
          "x": 8,
          "y": 50,
          "w": 84,
          "at": 4000,
          "enter": "fade",
          "color": "orange"
        }
      ]
    },
    {
      "duration_ms": 11000,
      "caption": "Commit-wait: hold the result until TT.after(s) is true.",
      "narration": "Before releasing locks and acknowledging, the leader waits until s is definitely in the past. After that, any later transaction gets a larger timestamp.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Commit-wait",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "p",
