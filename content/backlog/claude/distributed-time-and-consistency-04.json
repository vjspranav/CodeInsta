    {
      "duration_ms": 9000,
      "caption": "TrueTime returns an interval, not a point: real time is inside it.",
      "narration": "TrueTime does not return a timestamp. TT.now returns an interval, and absolute time is guaranteed to lie inside it.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "TrueTime API",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "TT.now()    -> [earliest,\n               latest]\nTT.after(t)  -> t passed?\nTT.before(t) -> t not yet?",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "n",
          "type": "text",
          "text": "Width of the interval is the uncertainty, epsilon.",
          "x": 8,
          "y": 52,
          "w": 84,
          "at": 4000,
          "enter": "fade"
        },
        {
          "id": "f",
