    {
      "duration_ms": 9000,
      "caption": "If T1 commits before T2 starts, then s1 < s2: external consistency.",
      "narration": "The result is external consistency: if T1 finishes before T2 begins in real time, the first timestamp is smaller. Spanner is strictly serializable.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "External consistency",
