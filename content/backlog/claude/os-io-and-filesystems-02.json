      ]
    },
    {
      "duration_ms": 10000,
      "caption": "fsync writes the file's dirty data and metadata, flushes the device cache, and waits.",
      "narration": "fsync forces the file's dirty pages and needed metadata out, issues a device cache flush, and blocks until the device confirms. fdatasync skips unneeded metadata.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "What fsync forces",
