    {
      "duration_ms": 10000,
      "caption": "Background writeback starts at dirty_background_ratio, writers are throttled at dirty_ratio.",
      "narration": "Flushers start at the background ratio, ten percent by default. At twenty percent writers are throttled, and pages older than thirty seconds get written.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "When pages are written",
          "x": 8,
          "y": 6,
          "w": 84,
