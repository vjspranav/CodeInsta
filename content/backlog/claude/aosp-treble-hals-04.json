        },
        {
          "id": "n",
          "type": "text",
          "text": "Clients trigger start; idle service unregisters and exits",
          "x": 8,
          "y": 48,
          "w": 84,
          "h": 12,
          "color": "green",
          "at": 6000,
          "enter": "fade"
        }
      ]
    }
