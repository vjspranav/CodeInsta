    {
      "duration_ms": 12000,
      "caption": "MCS lock: each waiter spins on its own node; the lock is just a tail pointer.",
      "narration": "MCS gives each waiter its own queue node and spins on a private flag. The lock itself is just a tail pointer, and release hands off to the next node.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "MCS queue lock",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "c",
          "text": "struct mcs_spinlock {\n  struct mcs_spinlock *next;\n  int locked;\n};",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 20.6,
          "at": 500,
          "enter": "fade"
        },
        {
          "id": "s",
          "type": "list",
          "items": [
            "Acquire: xchg tail, link prev->next",
            "Spin on own node->locked",
            "Release: set next->locked = 1"
          ],
          "x": 8,
          "y": 48,
          "w": 84,
          "h": 24.1,
          "at": 4500,
          "enter": "slide-up"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "qspinlock packs it in 4 bytes: locked byte, pending bit, and a tail of CPU number plus nesting index.",
      "narration": "Linux's qspinlock fits it into four bytes: a locked byte, a pending bit, and a tail encoding the CPU and a nesting index into per-CPU nodes.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "qspinlock layout (4 bytes)",
