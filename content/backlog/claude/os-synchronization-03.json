    {
      "duration_ms": 10000,
      "caption": "Ticket locks are fair: take a ticket, spin until owner equals it.",
      "narration": "A ticket lock is fair. Each waiter takes the next ticket and spins until the owner counter reaches it, so waiters run in FIFO order.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Ticket spinlock",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "c",
          "text": "t = fetch_inc(&lock->next);\nwhile (lock->owner != t)\n  cpu_relax();\n/* unlock: lock->owner++ */",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 20.6,
          "at": 500,
          "enter": "fade"
        },
        {
          "id": "hl",
          "type": "highlight",
          "target": "c",
          "at": 5500,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "All waiters spin on one cache line, so every release invalidates it in every waiter's cache.",
      "narration": "But every waiter spins on the same cache line. Each unlock invalidates that line in all of them, so coherence traffic grows with the CPU count.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "The cache-line storm",
