        },
        {
          "id": "st",
          "type": "list",
          "items": [
            "Read ELF + program headers",
            "begin_new_exec: drop old mm",
            "Map every PT_LOAD, zero .bss",
            "Open and map PT_INTERP",
            "create_elf_tables on stack"
          ],
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up",
          "color": "blue"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "The new stack holds argc, argv, envp and the auxiliary vector.",
      "narration": "On the new stack the kernel pushes argc, argv and envp, followed by the auxiliary vector. AT_PHDR, AT_ENTRY and AT_BASE tell ld.so where everything is.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Initial stack",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "stk",
          "type": "code",
          "lang": "text",
          "text": "argc | argv[] | envp[]\nAT_PHDR  program headers\nAT_ENTRY program entry\nAT_BASE  ld.so base",
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up"
        },
        {
          "id": "dbg",
          "type": "text",
