    {
      "duration_ms": 11000,
      "caption": "System V x86-64 passes six integer args in registers and eight float args in xmm0 to xmm7.",
      "narration": "In System V x86-64, integer arguments go in rdi, rsi, rdx, rcx, r8, r9, and floats in xmm0 to xmm7. Results return in rax or xmm0.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "System V x86-64",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "int/ptr: rdi rsi rdx rcx r8 r9",
            "float: xmm0 - xmm7",
            "return: rax (rdx:rax), xmm0",
            "callee-saved: rbx rbp r12-r15",
            "rsp 16-byte aligned at call"
          ],
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "color": "blue",
          "at": 1300
        }
      ]
    },
    {
      "duration_ms": 11000,
      "caption": "AAPCS64 passes eight integer args in x0 to x7 and eight float args in v0 to v7.",
      "narration": "AAPCS64 uses x0 to x7 for integers and v0 to v7 for floats. Results return in x0 or v0, and x8 carries an indirect result pointer.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "AAPCS64",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "int/ptr: x0 - x7",
            "float: v0 - v7 (d0, s0)",
            "return: x0 / v0; x8 = result ptr",
            "callee-saved: x19 - x28",
            "x29 = FP, x30 = LR, sp 16-aligned"
          ],
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "color": "green",
          "at": 1300
        }
      ]
    },
    {
      "duration_ms": 11000,
      "caption": "Integer and float registers are assigned independently, so the same call maps differently per ABI.",
      "narration": "Integer and float registers are assigned independently. For a long, a double and a long, SysV uses rdi, xmm0, rsi, and AAPCS64 uses x0, d0, x1.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "long f(long a, double b, long c)",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "s",
          "type": "code",
          "lang": "text",
          "text": "SysV:    a=rdi  b=xmm0  c=rsi",
          "x": 8,
