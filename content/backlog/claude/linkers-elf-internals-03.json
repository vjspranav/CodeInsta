    {
      "duration_ms": 10000,
      "caption": "Code calls a fixed PLT stub, which jumps through a writable GOT slot.",
      "narration": "Position-independent code can't hardcode printf's address. So it calls a local PLT stub, which jumps through a pointer stored in the GOT.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Indirection: PLT then GOT",
          "x": 8,
          "y": 6,
          "w": 84,
