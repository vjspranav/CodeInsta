          "enter": "fade"
        },
        {
          "id": "call",
          "type": "box",
          "text": "call printf@plt",
          "x": 8,
          "y": 20.0,
          "w": 36,
          "h": 14.2,
          "color": "blue",
          "at": 600,
          "enter": "pop"
        },
        {
          "id": "plt",
          "type": "box",
          "text": "PLT stub",
          "x": 56,
          "y": 20.0,
          "w": 36,
          "h": 14.2,
          "color": "orange",
          "at": 600,
          "enter": "pop"
        },
        {
          "id": "got",
          "type": "box",
          "text": "GOT[printf] (.got.plt, writable)",
          "x": 8,
          "y": 43.2,
          "w": 84,
          "h": 11,
          "color": "purple",
          "at": 1900,
          "enter": "pop"
        },
