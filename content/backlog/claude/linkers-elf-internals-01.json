          "text": "Type  Offset  Flags\nLOAD  0x0000  R\nLOAD  0x1000  R E\nLOAD  0x2000  R\nLOAD  0x2de8  RW",
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up"
        },
