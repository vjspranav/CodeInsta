    {
      "duration_ms": 9000,
      "caption": "Wall clocks drift; Lamport counters ignore real time. HLC wants both.",
      "narration": "Physical clocks are skewed and can jump. Lamport clocks are causal but meaningless as dates. A hybrid logical clock gives you both.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Why a hybrid?",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "w",
          "type": "box",
          "text": "Wall clock\nreadable, skewed",
          "x": 8,
          "y": 22,
          "w": 38,
          "h": 14,
          "color": "orange",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "l",
          "type": "box",
          "text": "Lamport\ncausal, no date",
          "x": 54,
          "y": 22,
          "w": 38,
          "h": 14,
          "color": "blue",
          "at": 1000,
          "enter": "pop"
        },
        {
          "id": "hlc",
          "type": "box",
          "text": "HLC: (l, c)",
          "x": 30,
          "y": 52,
          "w": 40,
          "h": 12,
          "color": "green",
          "at": 3000,
          "enter": "pop"
        },
        {
          "id": "a1",
