  "scenes": [
    {
      "duration_ms": 9000,
      "caption": "Before any attribute: the longest matching prefix always wins.",
      "narration": "Forwarding picks the longest matching prefix before BGP attributes matter. A more specific route beats everything else.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Prefix length first",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "203.0.113.0/22   via A\n203.0.113.0/24   via B",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "n",
          "type": "text",
          "text": "Traffic for 203.0.113.5 goes via B, the /24.",
          "x": 8,
          "y": 44,
          "w": 84,
