        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "RPKI ROV: reject invalid origin",
            "ROA maxLength: block /24 hijacks",
            "Customer prefix-list filters"
          ],
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
