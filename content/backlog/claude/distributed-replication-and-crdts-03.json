{
  "version": 1,
  "title": "RGA: text without conflicts",
  "hook": "How do text-editing CRDTs like RGA keep character order consistent?",
  "topic": "distributed/crdt/sequence-crdts-rga",
  "tags": [
    "distributed",
    "crdt",
    "collaborative-editing"
  ],
  "level": "advanced",
  "series": "distributed-replication-and-crdts",
  "series_index": 3,
  "scenes": [
    {
      "duration_ms": 10000,
      "caption": "Index-based inserts diverge: the same index means different places.",
      "narration": "If two users insert at index one of the text A B concurrently, applying each other operations by index gives different orders on each side.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Why indexes fail",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "d",
          "type": "box",
          "text": "Doc: A B",
          "x": 28,
          "y": 22,
          "w": 44,
          "h": 10,
          "color": "gray",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "u1",
          "type": "box",
          "text": "User 1\ninsert(1, X)",
          "x": 8,
          "y": 42,
          "w": 38,
          "h": 12,
          "color": "blue",
          "at": 1500,
          "enter": "pop"
        },
        {
          "id": "u2",
          "type": "box",
          "text": "User 2\ninsert(1, Y)",
          "x": 54,
          "y": 42,
          "w": 38,
          "h": 12,
          "color": "orange",
          "at": 1500,
          "enter": "pop"
        },
        {
          "id": "n",
          "type": "text",
          "text": "Replaying by index can yield A X Y B on one side and A Y X B on the other.",
          "x": 8,
          "y": 64,
          "w": 84,
          "at": 4500,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "Every character is a node with a unique ID and a reference to its left neighbour.",
      "narration": "RGA gives every character a unique ID, a Lamport counter plus replica ID, and records which node it was inserted after.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Characters have IDs",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "node {\n  id    (counter, replica)\n  char  'X'\n  after  parentId\n  deleted bool }",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "n",
          "type": "text",
          "text": "Position is \"right after node P\", never an integer.",
          "x": 8,
          "y": 56,
          "w": 84,
          "at": 4500,
          "enter": "fade"
        },
        {
          "id": "f",
          "type": "highlight",
          "target": "c",
          "at": 6500,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 12000,
      "caption": "Concurrent inserts after the same node are ordered by ID, newest first.",
      "narration": "Both X and Y reference A. When integrating, skip over any neighbours with a larger ID, then insert. Every replica lands on the same order.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Integration rule",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "X = (2, r1)   Y = (2, r2)\nboth after A, r2 > r1",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "r",
          "type": "code",
          "lang": "text",
          "text": "scan right of A:\n  skip nodes with id > new.id\n  insert here",
          "x": 8,
          "y": 40,
          "w": 84,
          "at": 3000,
          "enter": "slide-up"
        },
        {
          "id": "res",
          "type": "box",
          "text": "Both replicas: A Y X B",
          "x": 8,
          "y": 66,
          "w": 84,
          "h": 10,
          "color": "green",
          "at": 7000,
          "enter": "pop"
        },
        {
          "id": "f",
          "type": "highlight",
          "target": "res",
          "at": 9000,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 9000,
      "caption": "Deletes only mark nodes as tombstones, so later inserts can still find them.",
      "narration": "Deleting a character just sets a flag. The node stays, because another user may have inserted relative to it.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Deletion",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "delete(id):\n  node(id).deleted = true",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Hidden from rendering",
            "Still anchors concurrent inserts",
            "Removed only once all replicas saw it"
          ],
          "x": 8,
          "y": 44,
          "w": 84,
          "at": 3000,
          "enter": "slide-up"
        },
        {
          "id": "f",
          "type": "highlight",
          "target": "c",
          "at": 5500,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "Cost: metadata per character, which real implementations compress.",
      "narration": "The price is per-character metadata and tombstones. Libraries such as Automerge address it with operation IDs like counter at actor, and compact storage.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Trade-offs",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Per-character ID + parent metadata",
            "Tombstones until garbage collected",
            "No central server needed"
          ],
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "f",
          "type": "highlight",
          "target": "l",
          "at": 4500,
          "enter": "fade"
        }
      ]
    }
  ],
  "takeaway": "RGA anchors each character to a unique parent ID and orders concurrent siblings by ID, so replicas converge without indexes."
}
