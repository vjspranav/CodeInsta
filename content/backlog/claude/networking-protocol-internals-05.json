    {
      "duration_ms": 12000,
      "caption": "Answers are cached for their TTL, and so are referrals and NXDOMAIN.",
      "narration": "The resolver caches answers for the record TTL, and the NS referrals too, so the next lookup skips the root. Negative answers are cached based on the SOA record.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Caching",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "A record: cached for its TTL",
            "NS and glue: skip root and TLD next time",
            "NXDOMAIN: negative cache, RFC 2308"
          ],
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "f",
          "type": "highlight",
          "target": "l",
