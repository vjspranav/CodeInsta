        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "# /etc/nsswitch.conf\nhosts: files dns",
          "x": 8,
          "y": 22,
          "w": 84,
          "at": 500,
          "enter": "slide-up"
        },
        {
          "id": "f",
          "type": "box",
