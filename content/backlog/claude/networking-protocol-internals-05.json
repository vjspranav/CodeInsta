    {
      "duration_ms": 14000,
      "caption": "The recursive resolver walks root, TLD, then authoritative servers.",
      "narration": "On a cache miss the resolver asks a root server, gets NS records for the TLD, asks that, gets NS records for the zone, and finally asks the authoritative server for the A record.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Iterative walk",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "r",
          "type": "box",
          "text": "root",
          "x": 8,
          "y": 22,
          "w": 26,
          "h": 9,
          "color": "gray",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "t",
          "type": "box",
          "text": ".com TLD",
          "x": 37,
          "y": 22,
          "w": 26,
          "h": 9,
          "color": "orange",
          "at": 1500,
          "enter": "pop"
        },
        {
          "id": "au",
          "type": "box",
          "text": "example.com auth",
          "x": 66,
          "y": 22,
          "w": 28,
          "h": 9,
          "color": "green",
          "at": 2500,
          "enter": "pop"
        },
