      "duration_ms": 10000,
      "caption": "A lexer is a list of regexes plus two rules: take the longest match, and break ties by rule order.",
      "narration": "A lexer is one regex per token kind. At each position it takes the longest match, and on a tie the earlier rule wins.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Lexer rules",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "IDENT  [a-z]+",
            "NUM    [0-9]+",
            "IF     if   (listed before IDENT)",
            "Longest match, then rule order"
          ],
          "x": 8,
