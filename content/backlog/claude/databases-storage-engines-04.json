    {
      "duration_ms": 11000,
      "caption": "Detect the cycle, abort a victim; Postgres checks after deadlock_timeout.",
      "narration": "The lock manager finds cycles in the waits-for graph and aborts one victim. Postgres starts checking after deadlock_timeout, one second by default, and raises error 40P01.",
      "elements": [
        {
