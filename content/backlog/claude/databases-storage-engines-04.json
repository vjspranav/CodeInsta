        }
      ]
    },
    {
      "duration_ms": 11000,
      "caption": "Strict 2PL: acquire as you go, release everything only at commit or abort.",
      "narration": "Under strict two-phase locking, a transaction acquires locks as it needs them and holds all of them until commit or abort. That prevents dirty reads and cascading aborts.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Strict 2PL",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "g",
          "type": "box",
          "text": "Growing: acquire locks",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 10,
          "color": "blue",
          "at": 500,
          "enter": "pop"
        },
        {
          "id": "c",
          "type": "box",
          "text": "Commit or abort",
          "x": 8,
          "y": 40,
          "w": 84,
          "h": 10,
          "color": "purple",
          "at": 2500,
          "enter": "pop"
        },
        {
          "id": "r",
          "type": "box",
          "text": "Release all locks at once",
          "x": 8,
