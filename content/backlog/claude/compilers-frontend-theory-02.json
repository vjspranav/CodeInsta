    {
      "duration_ms": 10500,
      "caption": "A shift-reduce conflict is when the table allows both actions, as in the dangling else.",
      "narration": "A shift-reduce conflict means the table allows both actions. In the dangling else, seeing else could shift or reduce. Yacc and Bison shift by default.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Dangling else",
          "x": 8,
          "y": 5,
          "w": 84,
