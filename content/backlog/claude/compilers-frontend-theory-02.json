    {
      "duration_ms": 11500,
      "caption": "LR decides after seeing a whole right-hand side, while LL must commit before seeing it.",
      "narration": "LR waits until a whole right-hand side is seen, plus lookahead, before deciding. LL commits at the start. So every LL(k) grammar is LR(k), not the reverse.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Why LR is stronger",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "LL: commit when rule starts",
            "LR: decide after full RHS + lookahead",
            "Left recursion is fine in LR",
            "LL(k) grammars are a subset of LR(k)"
          ],
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "color": "purple",
          "at": 1300
        }
      ]
