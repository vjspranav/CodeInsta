      "duration_ms": 10000,
      "caption": "Each task accumulates vruntime: real CPU time scaled by its weight. The smallest vruntime runs next.",
      "narration": "CFS tracks vruntime, real run time scaled inversely by weight. Heavier tasks accumulate it slower, so the task with the smallest value is the most owed.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "vruntime: weighted run time",
          "x": 8,
          "y": 6,
          "w": 84,
