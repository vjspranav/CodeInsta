          "at": 0,
          "enter": "fade"
        },
        {
          "id": "ops",
          "type": "list",
          "items": [
            "tick: update_curr() charges vruntime",
            "enqueue: rb-tree insert, O(log n)",
            "pick: cached leftmost, O(1)",
            "preempt when current ran past its slice"
          ],
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 38.8,
