    {
      "duration_ms": 9000,
      "caption": "At OTA time the new framework's matrix is checked against the device manifest, and a mismatch blocks it.",
      "narration": "At OTA time the new framework matrix is checked against the installed device manifest. If any requirement fails, the update is rejected.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "OTA gate",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "new",
          "type": "box",
          "text": "New system: framework matrix",
          "x": 15,
