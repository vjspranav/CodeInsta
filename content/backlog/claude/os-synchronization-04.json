    {
      "duration_ms": 10000,
      "caption": "volatile only forces the compiler to emit each access: no fence, no atomicity, no ordering with other accesses.",
      "narration": "Volatile only forces the compiler to emit each access. It adds no hardware fence, gives no atomicity, and does not order the surrounding non-volatile accesses.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "What volatile does not do",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "v",
          "type": "list",
          "items": [
            "No CPU fence emitted",
            "No atomic read-modify-write",
            "Does not order plain accesses",
            "Weak CPUs (arm64, POWER) reorder anyway"
          ],
          "x": 8,
          "y": 22,
