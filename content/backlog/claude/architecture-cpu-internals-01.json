    {
      "duration_ms": 11500,
      "caption": "Every instruction gets a ROB entry in program order at dispatch.",
      "narration": "At dispatch, each instruction also takes an entry at the tail of the reorder buffer, recording its destination, status and any exception. Execution can finish in any order.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "The reorder buffer",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "rob",
          "type": "list",
          "items": [
            "head: oldest, waiting to retire",
            "entry: dest reg, done bit, fault",
            "tail: newest, just dispatched"
          ],
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up",
          "color": "blue"
        },
        {
          "id": "n",
          "type": "text",
          "text": "Skylake: 224 entries.",
          "x": 8,
          "y": 47.0,
          "w": 84,
          "at": 1900,
          "enter": "fade",
          "color": "gray"
        }
      ]
    },
    {
      "duration_ms": 13500,
      "caption": "Only the oldest completed entry may commit; stores become visible and faults are taken then.",
      "narration": "Retirement happens at the head, in order. Only then does architectural state update and a store leave the pipeline. Faults are recorded in the entry and raised at the head, giving precise exceptions.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "In-order retirement",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "list",
          "items": [
            "Head done? commit, free entry",
            "Head faulted? take exception",
            "Younger entries: discard"
          ],
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up",
          "color": "green"
        },
