    {
      "duration_ms": 10000,
      "caption": "One lost segment stalls delivery of every stream behind it.",
      "narration": "If one packet is lost, TCP withholds all later bytes from the application until the retransmission arrives, even bytes belonging to other streams.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "The blocking",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
