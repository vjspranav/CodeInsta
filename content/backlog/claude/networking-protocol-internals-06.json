    {
      "duration_ms": 10000,
      "caption": "QUIC packets carry STREAM frames with a stream ID and offset.",
      "narration": "QUIC puts stream ID and byte offset in each STREAM frame. The transport itself knows about streams, so ordering is tracked per stream.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "QUIC frames",
          "x": 8,
