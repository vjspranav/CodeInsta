        }
      ]
    },
    {
      "duration_ms": 11000,
      "caption": "A lone reader gets Exclusive; a second reader makes both copies Shared.",
      "narration": "The first core to read a line gets it Exclusive. When a second core reads it, the snoop shows another copy, and both caches move to Shared.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Reads",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
