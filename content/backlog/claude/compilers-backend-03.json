    {
      "duration_ms": 12000,
      "caption": "Per basic block, LLVM IR is turned into a DAG, then legalized, combined and matched to machine instructions.",
      "narration": "For each basic block, LLVM builds a SelectionDAG from IR. It is then combined, legalized for the target, matched to machine instructions, and scheduled into a linear order.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "The stages",
          "x": 8,
          "y": 5,
          "w": 84,
