    {
      "duration_ms": 11000,
      "caption": "Legalization rewrites operations the target lacks; GlobalISel and FastISel are the other selectors.",
      "narration": "Before selection, legalization expands or promotes unsupported types and operations, declared with setOperationAction. FastISel serves O0, and GlobalISel is the newer alternative, working on whole functions.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Legalization",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "setOperationAction(ISD::ROTL,\n    MVT::i32, Expand);",
