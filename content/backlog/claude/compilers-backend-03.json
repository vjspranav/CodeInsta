          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Build DAG (SelectionDAGBuilder)",
            "DAGCombine: simplify nodes",
            "Legalize types and operations",
            "Select: match target patterns",
            "Schedule into MachineInstrs"
          ],
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "color": "blue",
          "at": 1300
