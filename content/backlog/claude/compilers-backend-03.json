    {
      "duration_ms": 11500,
      "caption": "Target patterns written in TableGen describe DAG shapes and the instruction that replaces them.",
      "narration": "Targets describe instructions in TableGen with DAG patterns. This simplified example says an add of a multiply maps to a single fused multiply-add instruction, MADD on AArch64.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "TableGen patterns",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "def : Pat<(add (mul GPR32:$a,\n                     GPR32:$b),\n                 GPR32:$c),\n         (MADDWrrr $a, $b, $c)>;",
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "at": 1300
        },
        {
          "id": "n",
          "type": "text",
          "text": "Simplified from AArch64.",
          "x": 8,
