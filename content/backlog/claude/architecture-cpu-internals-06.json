          "text": "EL3: secure monitor (firmware)",
          "x": 8,
          "y": 20.0,
          "w": 84,
          "h": 11,
          "color": "red",
          "at": 600,
          "enter": "pop"
        },
        {
          "id": "el2",
          "type": "box",
          "text": "EL2: hypervisor",
          "x": 8,
          "y": 40.0,
          "w": 84,
          "h": 11,
          "color": "orange",
          "at": 1900,
          "enter": "pop"
        },
        {
          "id": "el1",
          "type": "box",
