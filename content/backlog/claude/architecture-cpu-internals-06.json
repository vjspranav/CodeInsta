    {
      "duration_ms": 10000,
      "caption": "Instructions raise levels: SVC to EL1, HVC to EL2, SMC to EL3; ERET returns.",
      "narration": "Software moves up with exception-generating instructions. SVC enters the kernel, HVC the hypervisor, and SMC the secure monitor. ERET returns to the lower level.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Crossing levels",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "i",
          "type": "code",
          "lang": "text",
          "text": "SVC #0   EL0 -> EL1  (syscall)\nHVC #0   EL1 -> EL2  (hypercall)\nSMC #0   EL1 -> EL3  (firmware)\nERET     return downward",
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up"
        },
        {
          "id": "hl-i",
          "type": "highlight",
          "target": "i",
          "at": 2300
        }
