    },
    {
      "duration_ms": 12000,
      "caption": "Linux runs at EL1; KVM-style hypervisors at EL2; pKVM puts its code at EL2 too.",
      "narration": "Linux's kernel proper runs at EL1. KVM needs EL2 to own stage-2 translation, which is how guest kernels at EL1 are isolated. Android's pKVM keeps its hypervisor code at EL2.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Kernel and hypervisor",
          "x": 8,
          "y": 6,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "k",
          "type": "list",
          "items": [
            "Linux kernel: EL1",
            "KVM / pKVM hypervisor: EL2",
            "Guest kernel: EL1 under stage-2",
            "Apps: EL0"
          ],
          "x": 8,
          "y": 20.0,
          "w": 84,
          "at": 600,
          "enter": "slide-up",
          "color": "purple"
        }
      ]
    },
    {
      "duration_ms": 12000,
      "caption": "EL3 plus the Secure world is TrustZone: Arm Trusted Firmware, then a trusted OS.",
      "narration": "TrustZone splits the system into Normal and Secure worlds. EL3 runs Arm Trusted Firmware, which switches worlds. The Secure world runs a trusted OS such as OP-TEE at secure EL1.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "TrustZone",
