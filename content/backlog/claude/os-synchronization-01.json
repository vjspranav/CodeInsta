          "target": "n",
          "at": 6000,
          "enter": "fade"
        }
      ]
    },
    {
      "duration_ms": 11000,
      "caption": "In the kernel: hash the key to a bucket, re-read the word under the bucket lock, then queue and sleep.",
      "narration": "In the kernel, the address is hashed to a bucket. Under the bucket lock the word is re-read; if it changed, return EAGAIN, otherwise queue and sleep.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Inside the kernel",
          "x": 8,
