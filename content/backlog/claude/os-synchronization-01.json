  "scenes": [
    {
      "duration_ms": 10000,
      "caption": "Uncontended lock: one atomic compare-and-swap on a user-space word, no syscall.",
      "narration": "A free mutex is just an integer in user memory. Locking it is one atomic compare-and-swap from zero to one, with no system call.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Fast path: one atomic",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "c",
          "text": "if (cmpxchg(&m->state, 0, 1)\n    == 0)\n  return; // locked",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 16.2,
          "at": 500,
          "enter": "fade"
        },
        {
          "id": "s",
          "type": "list",
          "items": [
            "0: unlocked",
            "1: locked, no waiters",
            "2: locked, waiters possible"
          ],
          "x": 8,
          "y": 50,
          "w": 84,
          "h": 19.7,
          "at": 3500,
          "enter": "slide-up"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "Contended: mark state 2 and sleep in futex(FUTEX_WAIT), which sleeps only if the value still matches.",
      "narration": "On contention the thread marks the state as two and calls futex wait. The kernel sleeps it only if the word still holds that value.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Slow path: FUTEX_WAIT",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "c",
          "text": "while (xchg(&m->state, 2) != 0)\n  futex(&m->state,\n        FUTEX_WAIT, 2);",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 20.6,
          "at": 500,
          "enter": "fade"
        },
        {
          "id": "n",
          "type": "text",
          "text": "FUTEX_WAIT sleeps only if *addr == 2.",
          "x": 8,
          "y": 54,
          "w": 84,
          "h": 10.8,
          "at": 4500,
          "enter": "fade",
          "color": "orange"
        },
        {
          "id": "hl",
