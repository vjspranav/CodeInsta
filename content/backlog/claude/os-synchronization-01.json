    {
      "duration_ms": 10000,
      "caption": "Unlock: exchange to 0; only if the old value was 2 does it call FUTEX_WAKE.",
      "narration": "Unlock swaps the word to zero. Only if the old value was two, meaning waiters exist, does it pay for a futex wake call.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Unlock wakes only if needed",
          "x": 8,
          "y": 6,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "c",
          "text": "if (xchg(&m->state, 0) == 2)\n  futex(&m->state,\n        FUTEX_WAKE, 1);",
          "x": 8,
