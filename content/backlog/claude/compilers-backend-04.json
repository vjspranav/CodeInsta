        }
      ]
    },
    {
      "duration_ms": 10500,
      "caption": "Dependence edges carry latencies; only independent instructions may swap.",
      "narration": "The scheduler builds a dependence graph. True read-after-write edges carry the producer's latency. The two load-add pairs share no edge, so they can freely interleave.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Dependence DAG",
          "x": 8,
          "y": 5,
          "w": 84,
