  "scenes": [
    {
      "duration_ms": 10000,
      "caption": "A dependent instruction right after a load stalls until the loaded value arrives.",
      "narration": "A load takes several cycles. If its consumer follows immediately, the pipeline stalls. Interleaving the independent pair hides that wait without changing the result.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Hide latency",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "b",
          "type": "code",
          "lang": "text",
          "text": "ldr x1,[x0]\nadd x2,x1,#1\nldr x3,[x4]\nadd x5,x3,#1",
          "x": 8,
          "y": 20,
          "w": 40,
          "enter": "slide-up",
          "color": "red",
          "at": 1300
        },
        {
          "id": "a",
          "type": "code",
          "lang": "text",
          "text": "ldr x1,[x0]\nldr x3,[x4]\nadd x2,x1,#1\nadd x5,x3,#1",
          "x": 52,
          "y": 20,
          "w": 40,
          "enter": "slide-up",
          "color": "green",
          "at": 2100
        },
        {
          "id": "a1",
          "type": "arrow",
          "from": "b",
          "to": "a",
          "enter": "draw",
          "label": "reorder",
          "at": 2900
        },
        {
          "id": "n",
          "type": "text",
          "text": "Same results, fewer stall cycles.",
          "x": 8,
          "y": 46,
          "w": 84,
          "enter": "fade",
          "color": "gray",
