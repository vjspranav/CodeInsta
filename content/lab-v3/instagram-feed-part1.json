    {
      "speaker": "senior",
      "text": "Show me the actual query.",
      "visuals": [
        {
          "do": "layout",
          "template": "board-full"
        },
        {
          "do": "code.show",
          "id": "naive-sql",
          "lang": "sql",
          "title": "feed_v1.sql",
          "code": [
            "SELECT p.id, p.caption",
            "FROM posts p",
            "JOIN follows f",
            "  ON f.followee_id",
            "   = p.author_id",
            "WHERE f.follower_id = 42",
            "ORDER BY p.created_at DESC",
            "LIMIT 20;"
