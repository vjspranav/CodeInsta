  "title": "How does Instagram load your feed so fast? (Part 2)",
  "topic": "lab-v3/instagram-feed/part-2",
  "genre": "story",
  "style": "sketch",
  "series": "instagram-feed",
  "series_index": 2,
  "glossary": [
    {
      "term": "p99",
      "full": "99th percentile latency",
      "note": "99 percent of requests are faster than this."
    },
    {
      "term": "fan-out",
      "full": "Fan-out on write",
      "note": "Copy one new post into every follower's feed when it is written."
    },
    {
      "term": "TTL",
      "full": "Time To Live",
      "note": "How long a cached value lives before it expires."
    },
    {
      "term": "CDN",
      "full": "Content Delivery Network",
      "note": "Servers worldwide that keep copies of images close to you."
    },
    {
      "term": "POP",
      "full": "Point of Presence",
      "note": "One CDN location, usually in your city."
    },
    {
      "term": "optimistic UI",
      "full": "Optimistic UI",
      "note": "Show the result instantly, confirm with the server afterwards."
    }
  ],
  "key_points": [
    "Don't join on every read: precompute feeds at write time.",
    "Celebrities break fan-out, so pull their posts at read time.",
    "Cache feeds, serve images from a CDN, and show likes optimistically."
  ],
