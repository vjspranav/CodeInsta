  "cast": [],
  "glossary": [
    {
      "term": "WAF",
      "full": "Web application firewall",
      "note": "It inspects requests and blocks ones that match attack rules."
    },
    {
      "term": "backtracking",
      "full": "A regex retrying other ways to match",
      "note": "Nested wildcards can retry so many ways that one match eats a whole CPU."
    }
  ],
  "key_points": [
    "A rule that blocks the right requests can still cost too much CPU to run.",
    "Tests need a cost budget as well as a correctness check.",
    "Emergency access must work when your own tools are down."
  ],
  "sources": [
    "https://blog.cloudflare.com/details-of-the-cloudflare-outage-on-july-2-2019/"
  ],
