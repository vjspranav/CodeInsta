  "glossary": [
    {
      "term": "DNS",
      "full": "Domain Name System",
      "note": "The phone book that turns names into addresses."
    },
    {
      "term": "TCP",
      "full": "Transmission Control Protocol",
      "note": "Re-sends what gets lost."
    }
  ],
  "key_points": [
    "DNS turns a name into an IP address.",
    "TCP re-sends lost packets, so pages still load."
  ],
  "beats": [
    {
      "speaker": "narrator",
      "text": "You type a URL and press enter. First, the browser asks DNS where the site lives.",
      "say": "You type a U R L and press enter. First, the browser asks D N S where the site lives.",
      "visuals": [
        {
          "do": "layout",
          "template": "board-full"
        },
        {
          "do": "seq.diagram",
          "id": "web",
          "actors": [
            "Browser",
            "DNS",
            "Server"
          ],
          "messages": [
            {
              "from": "Browser",
              "to": "DNS",
              "label": "where is example.com?"
            }
          ]
        },
        {
          "do": "define",
          "term": "DNS",
          "at": 0.55
        }
      ]
    },
    {
      "speaker": "senior",
      "text": "DNS answers with an IP address.",
      "say": "D N S answers with an I P address.",
      "visuals": [
        {
          "do": "seq.diagram",
          "id": "web",
          "messages": [
            {
              "from": "DNS",
              "to": "Browser",
              "label": "93.184.216.34",
              "reply": true
            }
          ]
        }
      ]
    },
    {
      "speaker": "rookie",
      "text": "Then a three way handshake: hello, hello back, got it.",
      "visuals": [
        {
          "do": "seq.diagram",
          "id": "web",
          "messages": [
            {
              "from": "Browser",
              "to": "Server",
              "label": "SYN"
            },
            {
              "from": "Server",
              "to": "Browser",
              "label": "SYN-ACK",
              "reply": true
            },
            {
              "from": "Browser",
              "to": "Server",
              "label": "ACK"
            }
          ]
        }
      ]
    },
    {
      "speaker": "narrator",
      "text": "Then packets cross the network. Sometimes one gets lost.",
      "visuals": [
        {
          "do": "layout",
          "template": "board-full"
        },
        {
          "do": "packet.flow",
          "id": "net",
          "nodes": [
            "Browser",
            "Router",
            "ISP",
            "Server"
          ],
          "packets": [
            {
              "from": "Browser",
              "to": "Router",
              "label": "GET /"
            },
            {
              "from": "Router",
              "to": "ISP",
              "label": "GET /"
            },
            {
              "from": "ISP",
              "to": "Server",
              "label": "GET /",
              "drop": true
            }
          ]
        }
      ]
    },
    {
      "speaker": "senior",
      "text": "TCP notices the gap and sends it again.",
      "say": "T C P notices the gap and sends it again.",
      "visuals": [
        {
          "do": "packet.flow",
          "id": "net",
          "packets": [
            {
              "from": "ISP",
              "to": "Server",
              "label": "GET /",
              "retry": true
            },
            {
              "from": "Server",
              "to": "Browser",
              "label": "200 OK"
            }
          ]
        }
      ]
    },
    {
      "speaker": "rookie",
      "text": "Now the server sends back HTML, and the browser builds a tree.",
      "say": "Now the server sends back H T M L, and the browser builds a tree.",
