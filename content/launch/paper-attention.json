  "glossary": [
    {
      "term": "RNN",
      "full": "Recurrent Neural Network",
      "note": "Reads text one word at a time, passing a memory along."
    },
    {
      "term": "attention weights",
      "full": "Attention weights",
      "note": "Scores for how much one word looks at another."
    },
    {
      "term": "GPU",
      "full": "Graphics Processing Unit",
      "note": "A chip that does many small calculations at once."
    },
    {
      "term": "Transformer",
      "full": "Transformer",
      "note": "The model design introduced in the paper, built on attention."
    },
    {
      "term": "GPT",
      "full": "Generative Pre-trained Transformer",
      "note": "A family of language models built on the Transformer."
    }
  ],
  "key_points": [
    "Old models read one word at a time, so they were slow and forgetful.",
    "Attention lets every word look at every other word and weigh who matters.",
    "Handling all words at once made training parallel, which led to today's large language models."
  ],
  "sources": [
    "https://arxiv.org/abs/1706.03762"
  ],
  "beats": [
