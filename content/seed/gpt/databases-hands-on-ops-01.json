    {
      "duration_ms": 10500,
      "caption": "Actual rows and times are per-loop averages when a node repeats.",
      "narration": "When a node runs many times, its actual rows and timings are averages per execution. Multiply by loops to understand repeated work; parent times include children.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Account for loops",
          "x": 8,
          "y": 5,
          "w": 84,
