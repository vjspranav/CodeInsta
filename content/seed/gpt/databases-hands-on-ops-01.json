      "caption": "Estimated rows and actual rows are not the same measurement.",
      "narration": "Read from the plan leaves upward. In this illustrative scan, ten estimated rows became ten thousand actual rows, potentially misleading every join decision above it.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Compare row counts",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 12,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "inspect",
          "type": "code",
