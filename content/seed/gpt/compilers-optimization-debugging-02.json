  "series_index": 2,
  "scenes": [
    {
      "duration_ms": 10500,
      "caption": "The overflow occurs inside the expression meant to detect it.",
      "narration": "This guard tries to catch increment overflow after doing the addition. For signed integers, that addition is undefined at the maximum value, so the guard fails.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "The broken guard",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 12,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "inspect",
          "type": "code",
          "lang": "c",
          "text": "int guarded(int n) {\n  if (n + 1 < n) return -1;\n  return n + 1;\n}",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 34,
          "at": 600,
          "enter": "slide-up"
        },
        {
          "id": "checks",
          "type": "list",
          "items": [
            "Example uses signed int",
            "Undefined behavior is not guaranteed wrap"
          ],
          "x": 8,
          "y": 64,
          "w": 84,
          "h": 24,
          "color": "green",
          "at": 3400,
          "enter": "slide-up"
        }
      ]
    },
    {
      "duration_ms": 10500,
      "caption": "For defined executions, n + 1 is greater than n.",
      "narration": "Emit optimized LLVM IR and inspect the function. The compiler can remove this branch because no defined signed addition makes the increment smaller than its input.",
