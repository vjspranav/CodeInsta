        },
        {
          "id": "inspect",
          "type": "code",
          "lang": "sh",
          "text": "clang -O1 -g \\\n  -fsanitize=undefined \\\n  guard.c driver.c -o guard-test\n./guard-test\n# driver.c calls guarded(INT_MAX)",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 34,
