{
  "version": 1,
  "title": "The overflow guard that disappears",
  "hook": "How does signed overflow UB make the compiler delete your bounds check?",
  "topic": "compilers/opt/undefined-behavior-miscompile",
  "tags": [
    "compilers",
    "undefined-behavior",
    "ubsan"
  ],
  "level": "intermediate",
