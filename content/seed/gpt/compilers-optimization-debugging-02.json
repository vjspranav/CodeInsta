    {
      "duration_ms": 10500,
      "caption": "A precondition protects the arithmetic itself.",
      "narration": "Check the maximum value before adding. For general signed addition, use a checked arithmetic builtin or explicit range checks; unsigned wrapping alone does not validate bounds.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Check before adding",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 12,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "inspect",
          "type": "code",
          "lang": "c",
          "text": "#include <limits.h>\nint guarded(int n) {\n  if (n == INT_MAX) return -1;\n  return n + 1;\n}",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 34,
          "at": 600,
          "enter": "slide-up"
        },
        {
          "id": "checks",
          "type": "list",
          "items": [
            "Test INT_MAX and nearby values",
            "Keep error signaling explicit in real APIs"
          ],
          "x": 8,
