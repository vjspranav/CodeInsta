    {
      "duration_ms": 10000,
      "caption": "UBSan reports the executed overflow path.",
      "narration": "Compile a harness that calls guarded with INT_MAX, then run it with undefined behavior sanitization. The diagnostic identifies signed overflow when that path executes.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Catch it dynamically",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 12,
          "at": 0,
