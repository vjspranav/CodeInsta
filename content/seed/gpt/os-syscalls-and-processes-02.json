          "enter": "fade"
        },
        {
          "id": "inspect",
          "type": "code",
          "lang": "text",
          "text": "# Selected Linux clone flags\nCLONE_VM     # address space\nCLONE_FILES  # descriptor table\nCLONE_THREAD # thread group",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 34,
          "at": 600,
          "enter": "slide-up"
        },
        {
          "id": "checks",
          "type": "list",
          "items": [
            "fork descriptors still share open-file state",
            "CLONE_THREAD requires other sharing flags"
          ],
          "x": 8,
          "y": 64,
          "w": 84,
          "h": 24,
          "color": "green",
          "at": 3400,
          "enter": "slide-up"
        }
      ]
    },
    {
      "duration_ms": 10000,
      "caption": "posix_spawn avoids an unrestricted application child callback.",
      "narration": "Posix spawn combines creation, selected file actions, and exec. Modern glibc uses shared memory with vfork semantics, avoiding fork's address space duplication work.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Spawn has a contract",
          "x": 8,
          "y": 5,
          "w": 84,
