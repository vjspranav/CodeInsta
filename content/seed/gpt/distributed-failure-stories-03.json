    {
      "duration_ms": 10000,
      "caption": "Pod readiness alone does not explain request failures.",
      "narration": "In a Kubernetes lab, inspect the workload and correlate application logs with failing request identifiers. A ready pod only passed the readiness test you configured.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Inspect the workload",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 12,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "inspect",
          "type": "code",
          "lang": "sh",
          "text": "kubectl -n lab get pods\nkubectl -n lab describe pod \"$POD\"\nkubectl -n lab logs \"$POD\" \\\n  --since=5m",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 34,
          "at": 600,
          "enter": "slide-up"
        },
        {
          "id": "checks",
          "type": "list",
          "items": [
