    {
      "duration_ms": 10000,
      "caption": "Detection needs user-path evidence without creating a new outage.",
      "narration": "Add bounded synthetic reads and caller side latency metrics. Keep liveness focused on recoverable process health; dependency failures should not trigger synchronized restart loops everywhere.",
      "elements": [
        {
          "id": "heading",
