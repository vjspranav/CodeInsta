          "enter": "fade"
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Timer reset by valid AppendEntries",
            "currentTerm++ and become candidate",
            "Vote for self",
            "Send RequestVote to all peers"
          ],
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "color": "orange",
          "at": 1300
        }
      ]
    },
    {
      "duration_ms": 11000,
      "caption": "A server votes once per term, and only for a candidate whose log is at least as up to date.",
      "narration": "Each server grants one vote per term, persisted to disk, and only if the candidate's log is at least as up to date. A majority wins.",
      "elements": [
        {
          "id": "h",
