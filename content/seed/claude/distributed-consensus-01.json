        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "One vote per term (votedFor persisted)",
            "Log up-to-date check: lastLogTerm, then lastLogIndex",
            "Majority of votes wins the term"
          ],
          "x": 8,
