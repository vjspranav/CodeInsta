    {
      "duration_ms": 11500,
      "caption": "A follower whose randomized election timeout expires increments the term and asks for votes.",
      "narration": "Followers reset a randomized election timeout, 150 to 300 milliseconds in the paper, on each heartbeat. On expiry, increment the term, vote for self, and request votes.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Timeout fires",
          "x": 8,
          "y": 5,
          "w": 84,
