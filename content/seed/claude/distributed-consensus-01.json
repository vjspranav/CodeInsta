          "w": 88,
          "enter": "slide-up",
          "at": 1300
        },
        {
          "id": "l",
          "type": "list",
          "items": [
            "Stale term in request: reject",
            "Higher term seen: adopt it, become follower"
          ],
          "x": 8,
