    {
      "duration_ms": 10000,
      "caption": "The closer ends in TIME_WAIT for 2 x MSL before the 4-tuple is free.",
      "narration": "The side that sends the first FIN walks through FIN_WAIT_1 and FIN_WAIT_2, and finally sits in TIME_WAIT after sending the last ACK.",
      "elements": [
