    {
      "duration_ms": 9000,
      "caption": "Conditionals live in properties and defaults, so the build graph stays analyzable.",
      "narration": "Per-arch differences go in nested properties, and shared settings go in defaults modules. Because nothing executes, tools can analyze or convert the files.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Variation without code",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "c",
          "type": "code",
          "lang": "text",
          "text": "cc_binary {\n    name: \"hello\",\n    defaults: [\"my_defaults\"],\n    arch: {\n        arm64: { srcs: [\"a64.c\"] },\n    },\n}",
          "x": 8,
          "y": 20,
