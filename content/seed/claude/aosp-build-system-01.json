    {
      "duration_ms": 10000,
      "caption": "Android.bp is declarative: a module type plus properties, with no control flow.",
      "narration": "Android.bp is declarative. Each module is a type and a set of properties, in a JSON-like syntax with no loops and no if statements.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "Android.bp",
          "x": 8,
          "y": 5,
          "w": 84,
          "h": 8,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "bp",
          "type": "code",
          "lang": "text",
          "text": "cc_binary {\n    name: \"hello\",\n    srcs: [\"hello.c\"],\n    shared_libs: [\"liblog\"],\n}",
          "x": 8,
          "y": 20,
          "w": 84,
          "h": 22,
          "at": 500,
          "enter": "slide-up"
