    {
      "duration_ms": 9500,
      "caption": "Cooper-Harvey-Kennedy computes idoms by iterating over reverse postorder with an intersect step.",
      "narration": "Cooper, Harvey and Kennedy visit blocks in reverse postorder, setting each idom to the intersection of its processed predecessors, until nothing changes.",
      "elements": [
        {
          "id": "h",
          "type": "title",
          "text": "Computing idoms",
          "x": 8,
          "y": 5,
          "w": 84,
          "at": 0,
          "enter": "fade"
        },
        {
          "id": "code",
          "type": "code",
          "lang": "text",
          "text": "idom[entry] = entry\nrepeat until no change:\n  for b in RPO, b != entry:\n    new = first processed pred\n    for p in other preds:\n      if idom[p] known:\n        new = intersect(p, new)\n    idom[b] = new",
          "x": 8,
          "y": 18,
          "w": 84,
          "enter": "slide-up",
          "at": 1300
        },
        {
          "id": "n",
          "type": "text",
          "text": "LLVM uses Semi-NCA instead.",
          "x": 8,
          "y": 62,
          "w": 84,
          "enter": "fade",
          "color": "gray",
          "at": 2100
        }
      ]
    },
