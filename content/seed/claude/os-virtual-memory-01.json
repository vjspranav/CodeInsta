          "at": 0,
          "enter": "fade"
        },
        {
          "id": "walk",
          "type": "code",
          "lang": "c",
          "text": "pgd = pgd_offset(mm, addr);\np4d = p4d_offset(pgd, addr);\npud = pud_offset(p4d, addr);\npmd = pmd_offset(pud, addr);\npte = pte_offset_map(pmd, addr);",
          "x": 8,
          "y": 22,
          "w": 84,
          "h": 29.4,
          "at": 500,
          "enter": "fade"
