    {
      "duration_ms": 10000,
      "caption": "Linux walks the same tree with pgd, p4d, pud, pmd and pte helpers.",
      "narration": "Linux names the levels pgd, p4d, pud, pmd and pte. With four-level paging the p4d level is folded away, but the code stays generic.",
      "elements": [
        {
          "id": "heading",
          "type": "title",
          "text": "The same walk in Linux",
          "x": 8,
          "y": 6,
          "w": 84,
